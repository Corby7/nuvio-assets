# Copy to .env and fill in. .env is gitignored; never commit real keys.
# AIOMetadata base URL, minus /manifest.json (Settings -> Addons in the app).
AIO_BASE_URL=
# Optional: upgrades tiles to TMDB w1280 backdrops.
TMDB_API_KEY=
# Optional: adds Fanart thumb art (the tiles with title logos). Needs TMDB_API_KEY.
FANART_API_KEY=
